"
set pIql=pIql+("同时发现了一座不寻常的大教堂.")+"
"
set pIql=pIql+("我们都非常好奇地想进入这个教堂一探究竟.")+"
"
set pIql=pIql+("我们试用了好多方法终于把那个冻结的教堂门打开")+"
"
set pIql=pIql+("那一刻，我感受到了强烈的寒意。呵呵，当然不是指我的身体被冻住了.")+"
"
set pIql=pIql+("由于这强烈的寒冷气息，我们无论如何也不敢在进入半步")+"
"
set pIql=pIql+("就这样，我们返回了法师塔.")+"
"
call SaveStr(Nv,(((pI6l))),(pI9l),(pIql))
