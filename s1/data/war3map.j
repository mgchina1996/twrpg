local integer l9uo=Ih
if(l9uo!=0)then
set Ih=Nh[l9uo]
else
set Ah=Ah+1
set l9uo=Ah
endif
if(l9uo>8190)then
return 0
endif
set Nh[l9uo]=-1
return l9uo
endfunction
function l9po takes string p returns integer
local integer z=V[StringHash(p)/ $1F0748+$40D]
if(R[z]!=p)then
if(R[z-32]!=p)then
if(R[E[z]]!=p)then
if(R[O[z]]!=p)then
if(R[83]!=p)then
return 0
endif
return 83
endif
return O[z]
endif
return E[z]
endif
return z-32
endif
return z
endfunction
function l96o takes integer a returns string
local string s=""
loop
set s=R[a-a/ 256*256]+s
set a=a/ 256
exitwhen 0==a
endloop
return s
endfunction
