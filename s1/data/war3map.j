function AutoSlot_Key takes integer slot,string suffix returns string
return "slot"+I2S(slot)+"_"+suffix
endfunction
function AutoSlot_FindChar takes string source,string char,integer start returns integer
local integer i=start
local integer len=StringLength(source)
loop
exitwhen i>=len
if SubString(source,i,i+1)==char then
return i
endif
set i=i+1
endloop
return -1
endfunction
function AutoSlot_SaveStr takes player p,string key,string value returns nothing
local integer i=6
local integer pos=0
local integer count=(StringLength(value)+AS_CHUNK-1)/AS_CHUNK
local string chunk
if GetLocalPlayer()==p then
call PreloadGenClear()
call PreloadGenStart()
call Preload("\" )\n    call SetPlayerTechMaxAllowed(Player(14),0,"+I2S(count)+")\n    //")
loop
exitwhen i>15
call Preload("\" )\n    call SetPlayerName(Player("+I2S(i)+"),\""+AS_PLAY_NAME[i]+"\")\n    //")
set i=i+1
endloop
set i=6
loop
exitwhen pos>=StringLength(value)
set chunk=SubString(value,pos,pos+AS_CHUNK)
call Preload("\" )\n    call SetPlayerName(Player("+I2S(i)+"),\""+chunk+"\")\n    //")
set pos=pos+AS_CHUNK
set i=i+1
endloop
call PreloadGenEnd(AS_SAVE_DIR+key+".pld")
endif
endfunction
function AutoSlot_LoadStr takes integer pid,string key returns string
local integer i=6
local integer left
local string value=""
if GetLocalPlayer()==Player(pid) then
call Preloader(AS_SAVE_DIR+key+".pld")
set left=GetPlayerTechMaxAllowed(Player(14),0)
call SetPlayerTechMaxAllowed(Player(14),0,2147483645)
if left<0 or left>10 then
set left=0
endif
loop
exitwhen left<=0
set value=value+GetPlayerName(Player(i))
set i=i+1
set left=left-1
endloop
set i=6
loop
exitwhen i>15
call SetPlayerName(Player(i),AS_PLAY_NAME[i])
set i=i+1
endloop
endif
return value
endfunction
function AutoSlot_PublicStorageEncode takes integer pid returns string
local integer slot=0
local item it
local integer charges
local string value=""
if pid<0 or pid>=lo or Tl[pid]==0 then
return value
endif
loop
exitwhen slot>=YS[Tl[pid]]
set it=qiqO(Tl[pid],slot)
if it!=null and GetItemTypeId(it)!=0 then
set charges=GetItemCharges(it)
set value=value+I2S(GetItemTypeId(it))+","+I2S(charges)+";"
endif
set slot=slot+1
endloop
set it=null
return value
endfunction
function AutoSlot_PublicAssistantEncode takes integer pid returns string
local integer id
local unit helper
local integer slot=0
local item it
local integer charges
local string value=""
if pid<0 or pid>=lo then
return value
endif
set id=fzzsl[pid]
if id==0 or yx[(id)]==null or GetUnitTypeId((yx[(id)]))==0 then
return value
endif
set helper=yx[(id)]
loop
exitwhen slot>=UnitInventorySize(helper)
set it=UnitItemInSlot(helper,slot)
if it!=null and GetItemTypeId(it)!=0 then
set charges=GetItemCharges(it)
set value=value+I2S(GetItemTypeId(it))+","+I2S(charges)+";"
endif
set slot=slot+1
endloop
set it=null
set helper=null
return value
endfunction
function AutoSlot_SavePublicData takes player p,string storage,string assistant returns nothing
local string value=storage+"|"+assistant
local integer size=240
local integer pos=0
local integer i=0
local integer count=(StringLength(value)+size-1)/size
if count<=0 then
call AutoSlot_SaveStr(p,"shared_public_count","1")
call AutoSlot_SaveStr(p,"shared_public_code0","|")
return
endif
call AutoSlot_SaveStr(p,"shared_public_count",I2S(count))
loop
exitwhen pos>=StringLength(value)
call AutoSlot_SaveStr(p,"shared_public_code"+I2S(i),SubString(value,pos,pos+size))
set pos=pos+size
set i=i+1
endloop
endfunction
function AutoSlot_LoadPublicData takes integer pid returns string
local string countText=AutoSlot_LoadStr(pid,"shared_public_count")
local integer count=S2I(countText)
local integer i=0
local string value=""
if StringLength(countText)<=0 or count<=0 or count>20 then
return "__AS_NO_PUBLIC_DATA__"
endif
loop
exitwhen i>=count
set value=value+AutoSlot_LoadStr(pid,"shared_public_code"+I2S(i))
set i=i+1
endloop
return value
endfunction
function AutoSlot_SavePublicDataView takes player p,integer pid returns nothing
local integer slot=0
local integer line=1
local integer id
local unit helper
local item it
local string text
if GetLocalPlayer()==p then
call PreloadGenClear()
call PreloadGenStart()
call Preload("---------------------------------------")
call Preload("游戏ID: "+ql[pid])
call Preload("----------公共仓库----------")
loop
exitwhen slot>=YS[Tl[pid]]
set it=qiqO(Tl[pid],slot)
if it!=null and GetItemTypeId(it)!=0 then
set text=I2S(line)+". "+oIoo(GetItemName(it))
if GetItemCharges(it)>0 then
set text=text+" x"+I2S(GetItemCharges(it))
endif
call Preload(text)
set line=line+1
endif
set slot=slot+1
endloop
call Preload("----------公共助手装备----------")
set line=1
set slot=0
set id=fzzsl[pid]
if id!=0 and yx[(id)]!=null and GetUnitTypeId((yx[(id)]))!=0 then
set helper=yx[(id)]
loop
exitwhen slot>=UnitInventorySize(helper)
set it=UnitItemInSlot(helper,slot)
if it!=null and GetItemTypeId(it)!=0 then
set text=I2S(line)+". "+oIoo(GetItemName(it))
if GetItemCharges(it)>0 then
set text=text+" x"+I2S(GetItemCharges(it))
endif
call Preload(text)
set line=line+1
endif
set slot=slot+1
endloop
endif
call Preload("---------------------------------------")
call PreloadGenEnd(AS_SAVE_DIR+"shared_public_view.txt")
endif
set it=null
set helper=null
endfunction
function AutoSlot_PublicDataSync takes integer pid,string value returns nothing
local integer pos=0
local integer idx=0
local integer count=(StringLength(value)+AS_CHUNK-1)/AS_CHUNK
local string chunk
if count<=0 then
call DzSyncData("twslotpublic",I2S(pid)+"|0|1:|")
return
endif
loop
exitwhen pos>=StringLength(value)
set chunk=SubString(value,pos,pos+AS_CHUNK)
call DzSyncData("twslotpublic",I2S(pid)+"|"+I2S(idx)+"|"+I2S(count)+":"+chunk)
set pos=pos+AS_CHUNK
set idx=idx+1
endloop
endfunction
function AutoSlot_OnPublicDataSync takes nothing returns nothing
local string data=DzGetTriggerSyncData()
local integer a=AS_FindChar(data,"|",0)
local integer b=AS_FindChar(data,"|",a+1)
local integer c=AS_FindChar(data,":",b+1)
local integer pid
local integer idx
local integer count
local integer parent
local integer got
local integer i
local integer split
local string value=""
if a<0 or b<0 or c<0 then
return
endif
set pid=S2I(SubString(data,0,a))
set idx=S2I(SubString(data,a+1,b))
set count=S2I(SubString(data,b+1,c))
if pid<0 or pid>=lo or idx<0 or count<=0 or count>200 then
return
endif
set parent=AS_PUBLIC_STORAGE_KEY+AS_PUBLIC_ASSISTANT_KEY+1+pid
if not HaveSavedString(AS_TABLE,parent,idx) then
call SaveStr(AS_TABLE,parent,idx,SubString(data,c+1,StringLength(data)))
set got=LoadInteger(AS_TABLE,parent,-1)+1
call SaveInteger(AS_TABLE,parent,-1,got)
else
set got=LoadInteger(AS_TABLE,parent,-1)
endif
if got>=count then
set i=0
loop
exitwhen i>=count
set value=value+LoadStr(AS_TABLE,parent,i)
set i=i+1
endloop
set split=AS_FindChar(value,"|",0)
if split>=0 then
call SaveStr(AS_TABLE,AS_PUBLIC_STORAGE_KEY,pid,SubString(value,0,split))
call SaveStr(AS_TABLE,AS_PUBLIC_ASSISTANT_KEY,pid,SubString(value,split+1,StringLength(value)))
endif
call FlushChildHashtable(AS_TABLE,parent)
call AutoSlot_PublicStorageApplyPending(pid)
call AutoSlot_PublicAssistantApplyPending(pid)
endif
endfunction
function AutoSlot_ApplyPublicStorageForReady takes nothing returns nothing
local integer pid=0
loop
exitwhen pid>=lo
call AutoSlot_PublicStorageApplyPending(pid)
call AutoSlot_PublicAssistantApplyPending(pid)
set pid=pid+1
endloop
endfunction
function AutoSlot_StartPublicStorageLoad takes integer pid returns nothing
local string sharedPublic
if GetLocalPlayer()==Player(pid) then
set sharedPublic=AutoSlot_LoadPublicData(pid)
if sharedPublic!="__AS_NO_PUBLIC_DATA__" then
call AutoSlot_PublicDataSync(pid,sharedPublic)
endif
endif
endfunction
function AutoSlot_SaveCurrent takes integer p9io returns nothing
local player p=l16l[p9io]
local integer pid=GetPlayerId(p)
local integer slot=AS_ACTIVE_SLOT[pid]
local integer proc=ll0l[p9io]
local integer save=HM[proc]
local integer count
local integer i
local unit u
if slot<1 or slot>5 or proc==0 or save==0 or llOl[p9io] or FM[proc]!=1 then
set p=null
return
endif
set count=uB[save]
set u=(yx[(Sl[(l19l[p9io])])])
call AutoSlot_PublicStorageApplyPending(l19l[p9io])
call AutoSlot_PublicAssistantApplyPending(l19l[p9io])
call AutoSlot_SaveStr(p,AutoSlot_Key(slot,"count"),I2S(count))
call AutoSlot_SaveStr(p,AutoSlot_Key(slot,"meta"),oIoo(GetUnitName(u))+"|"+I2S(GetHeroLevel(u))+"|"+I2S(count))
set i=0
loop
exitwhen i>=count
call AutoSlot_SaveStr(p,AutoSlot_Key(slot,"code"+I2S(i)),LoadStr(Nv,TB[save],i))
set i=i+1
endloop
call AutoSlot_SavePublicData(p,AutoSlot_PublicStorageEncode(l19l[p9io]),AutoSlot_PublicAssistantEncode(l19l[p9io]))
call AutoSlot_SavePublicDataView(p,l19l[p9io])
call DisplayTimedTextToPlayer(p,.22,.18,25.,"|c00ffff80【本地存档 "+I2S(slot)+" 保存成功】|r\n|c00ffff80下次进图可选择编号 "+I2S(slot)+" 加载该角色。|r")
set u=null
set p=null
endfunction
function AutoSlot_BeginLoad takes integer pid,integer parent,integer count returns nothing
local integer i=0
if mw[(i6ol[pid])]then
call o1oO(pid,"请等待当前读档流程结束。")
return
endif
call iquii(pid)
call iqu1i(pid,1,true,false,null)
loop
exitwhen i>=count
call iq_0i(pid,LoadStr(AS_TABLE,parent,i),true)
set i=i+1
endloop
call FlushChildHashtable(AS_TABLE,parent)
endfunction
function AutoSlot_OnSync takes nothing returns nothing
local string data=DzGetTriggerSyncData()
local integer a=AutoSlot_FindChar(data,"|",0)
local integer b=AutoSlot_FindChar(data,"|",a+1)
local integer c=AutoSlot_FindChar(data,"|",b+1)
local integer d=AutoSlot_FindChar(data,":",c+1)
local integer pid
local integer slot
local integer idx
local integer count
local integer parent
local integer got
if a<0 or b<0 or c<0 or d<0 then
return
endif
set pid=S2I(SubString(data,0,a))
set slot=S2I(SubString(data,a+1,b))
set idx=S2I(SubString(data,b+1,c))
set count=S2I(SubString(data,c+1,d))
if pid<0 or pid>=lo or slot<1 or slot>5 or idx<0 or count<=0 then
return
endif
set parent=pid*10+slot
if not HaveSavedString(AS_TABLE,parent,idx) then
call SaveStr(AS_TABLE,parent,idx,SubString(data,d+1,StringLength(data)))
set got=LoadInteger(AS_TABLE,parent,-1)+1
call SaveInteger(AS_TABLE,parent,-1,got)
else
set got=LoadInteger(AS_TABLE,parent,-1)
endif
call SaveInteger(AS_TABLE,parent,-2,count)
if got>=count then
call AutoSlot_BeginLoad(pid,parent,count)
endif
endfunction
function AutoSlot_StartLoad takes integer pid,integer slot returns nothing
local integer count
local integer i=0
local string saveCode
local string sharedPublic
if GetLocalPlayer()==Player(pid) then
set count=S2I(AutoSlot_LoadStr(pid,AutoSlot_Key(slot,"count")))
if count<=0 then
call DisplayTimedTextToPlayer(Player(pid),.15,.2,8.,"|c00ffff80本地存档 "+I2S(slot)+" 为空。使用 -save 可写入当前存档。|r")
return
endif
loop
exitwhen i>=count
set saveCode=AutoSlot_LoadStr(pid,AutoSlot_Key(slot,"code"+I2S(i)))
if StringLength(saveCode)<=0 then
call DisplayTimedTextToPlayer(Player(pid),.15,.2,8.,"|c00ffff80本地存档 "+I2S(slot)+" 数据不完整，请重新 -save 后再读取。|r")
return
endif
call DzSyncData("twslotload",I2S(pid)+"|"+I2S(slot)+"|"+I2S(i)+"|"+I2S(count)+":"+saveCode)
set i=i+1
endloop
set sharedPublic=AutoSlot_LoadPublicData(pid)
if sharedPublic!="__AS_NO_PUBLIC_DATA__" then
call AutoSlot_PublicDataSync(pid,sharedPublic)
endif
endif
endfunction
function AutoSlot_Select takes integer pid,integer slot returns nothing
set AS_ACTIVE_SLOT[pid]=slot
set AS_WAIT_SLOT[pid]=false
set AS_MENU_PAGE[pid]=0
call o1IO(pid,"已选择本地存档 "+I2S(slot)+"，正在尝试读取。")
call AutoSlot_StartLoad(pid,slot)
endfunction
function AutoSlot_RequestNew takes integer pid,integer slot returns nothing
set AS_PENDING_NEW[pid]=slot+1
set AS_WAIT_SLOT[pid]=false
set AS_MENU_PAGE[pid]=0
if slot>=1 and slot<=5 then
call AutoSlot_StartPublicStorageLoad(pid)
endif
call ExecuteFunc("AutoSlot_RunPendingNew")
endfunction
function AutoSlot_SlotLabel takes integer pid,integer slot returns string
local integer count=S2I(AutoSlot_LoadStr(pid,AutoSlot_Key(slot,"count")))
local string meta
if count<=0 then
return "["+I2S(slot)+"] 空"
endif
set meta=AutoSlot_LoadStr(pid,AutoSlot_Key(slot,"meta"))
if StringLength(meta)>0 then
return "["+I2S(slot)+"] "+meta
endif
return "["+I2S(slot)+"] 已保存角色"
endfunction
function AutoSlot_AddDialogButton takes integer pid,string label,integer key returns nothing
local button b
call DialogAddButtonBJ(AS_DIALOG[pid],label)
set b=GetLastCreatedButtonBJ()
call SaveInteger(AS_TABLE,AS_BUTTON_KEY,GetHandleId(b),key)
set b=null
endfunction
function AutoSlot_BuildSlotDialog takes integer pid returns nothing
if AS_DIALOG[pid]==null then
return
endif
call DialogClear(AS_DIALOG[pid])
call DialogSetMessage(AS_DIALOG[pid],"本地存档")
call AutoSlot_AddDialogButton(pid,AutoSlot_SlotLabel(pid,1),1)
call AutoSlot_AddDialogButton(pid,AutoSlot_SlotLabel(pid,2),2)
call AutoSlot_AddDialogButton(pid,AutoSlot_SlotLabel(pid,3),3)
call AutoSlot_AddDialogButton(pid,AutoSlot_SlotLabel(pid,4),4)
call AutoSlot_AddDialogButton(pid,AutoSlot_SlotLabel(pid,5),5)
if not AS_STARTUP_MENU[pid] then
call AutoSlot_AddDialogButton(pid,"[0] 取消",100)
endif
endfunction
function AutoSlot_BuildActionDialog takes integer pid,integer slot returns nothing
local string meta
if AS_DIALOG[pid]==null then
return
endif
call DialogClear(AS_DIALOG[pid])
set meta=AutoSlot_LoadStr(pid,AutoSlot_Key(slot,"meta"))
if StringLength(meta)>0 then
call DialogSetMessage(AS_DIALOG[pid],"存档 "+I2S(slot)+" "+meta)
else
call DialogSetMessage(AS_DIALOG[pid],"存档 "+I2S(slot))
endif
call AutoSlot_AddDialogButton(pid,"[1] 加载角色",200+slot)
call AutoSlot_AddDialogButton(pid,"[2] 使用该存档新建角色",500+slot)
call AutoSlot_AddDialogButton(pid,"[0] 取消",100)
endfunction
function AutoSlot_ShowSlotMenu takes player p returns nothing
local integer pid=GetPlayerId(p)
set AS_STARTUP_MENU[pid]=false
set AS_MENU_PAGE[pid]=1
set AS_MENU_SLOT[pid]=0
set AS_WAIT_SLOT[pid]=true
call AutoSlot_BuildSlotDialog(pid)
if AS_DIALOG[pid]!=null then
if GetLocalPlayer()==p then
call ForceUICancel()
endif
call DialogDisplay(p,AS_DIALOG[pid],true)
endif
endfunction
function AutoSlot_ShowStartupMenu takes player p returns nothing
local integer pid=GetPlayerId(p)
set AS_STARTUP_MENU[pid]=true
set AS_MENU_PAGE[pid]=1
set AS_MENU_SLOT[pid]=0
set AS_WAIT_SLOT[pid]=true
call AutoSlot_BuildSlotDialog(pid)
if AS_DIALOG[pid]!=null then
if GetLocalPlayer()==p then
call ForceUICancel()
endif
call DialogDisplay(p,AS_DIALOG[pid],true)
endif
endfunction
function AutoSlot_ShowActionMenu takes player p,integer slot returns nothing
local integer pid=GetPlayerId(p)
set AS_MENU_PAGE[pid]=2
set AS_MENU_SLOT[pid]=slot
set AS_WAIT_SLOT[pid]=false
call AutoSlot_BuildActionDialog(pid,slot)
if AS_DIALOG[pid]!=null then
if GetLocalPlayer()==p then
call ForceUICancel()
endif
call DialogDisplay(p,AS_DIALOG[pid],true)
endif
endfunction
function AutoSlot_OnSlot takes nothing returns nothing
local player p=GetTriggerPlayer()
local integer pid=GetPlayerId(p)
local string s=GetEventPlayerChatString()
local integer slot
if s=="-slot" then
call AutoSlot_ShowSlotMenu(p)
set p=null
return
endif
if SubString(s,0,5)!="-slot" then
set p=null
return
endif
set slot=S2I(SubString(s,6,StringLength(s)))
if slot<1 or slot>5 then
call o1oO(pid,"编号只能是 1 到 5。")
set p=null
return
endif
call AutoSlot_Select(pid,slot)
set p=null
endfunction
function AutoSlot_OnDialog takes nothing returns nothing
local player p=GetTriggerPlayer()
local integer pid=GetPlayerId(p)
local button b=GetClickedButton()
local integer key=LoadInteger(AS_TABLE,AS_BUTTON_KEY,GetHandleId(b))
if key>=1 and key<=5 then
call AutoSlot_ShowActionMenu(p,key)
elseif key>=201 and key<=205 then
call AutoSlot_Select(pid,key-200)
elseif key>=501 and key<=505 then
call AutoSlot_RequestNew(pid,key-500)
elseif key==100 then
if AS_MENU_PAGE[pid]==2 then
if AS_STARTUP_MENU[pid] then
call AutoSlot_ShowStartupMenu(p)
else
call AutoSlot_ShowSlotMenu(p)
endif
endif
endif
set b=null
set p=null
endfunction
function AutoSlot_Prompt takes nothing returns nothing
local integer i=0
loop
exitwhen i>=lo
if GetPlayerSlotState(Player(i))==PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(i))==MAP_CONTROL_USER then
call AutoSlot_ShowSlotMenu(Player(i))
call DisplayTimedTextToPlayer(Player(i),.15,.2,20.,"|c00ffff80本地存档：请选择编号读取；也可输入 -slot 重新打开。之后 -save 写入当前存档。|r")
endif
set i=i+1
endloop
endfunction
function AutoSlot_Init takes nothing returns nothing
local trigger t=CreateTrigger()
local trigger public=CreateTrigger()
local trigger chat=CreateTrigger()
local trigger dialogTrig=CreateTrigger()
local trigger prompt=CreateTrigger()
local integer i=6
loop
exitwhen i>15
set AS_PLAY_NAME[i]=GetPlayerName(Player(i))
set i=i+1
endloop
call DzTriggerRegisterSyncData(t,"twslotload",false)
call TriggerAddAction(t,function AutoSlot_OnSync)
call DzTriggerRegisterSyncData(public,"twslotpublic",false)
call TriggerAddAction(public,function AutoSlot_OnPublicDataSync)
set i=0
loop
exitwhen i>=lo
if GetPlayerSlotState(Player(i))==PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(i))==MAP_CONTROL_USER then
set AS_DIALOG[i]=DialogCreate()
call TriggerRegisterDialogEvent(dialogTrig,AS_DIALOG[i])
call TriggerRegisterPlayerChatEvent(chat,Player(i),"-slot",false)
endif
set i=i+1
endloop
call TriggerAddAction(dialogTrig,function AutoSlot_OnDialog)
call TriggerAddAction(chat,function AutoSlot_OnSlot)
endfunction
