function lqio takes player lq1o returns string
local string lqlo=DzAPI_Map_GetPlayerUserName(lq1o)
local integer lqIo=StringLength(lqlo)
local integer lqoo=0
loop
exitwhen(lqoo==lqIo)
if(SubString(lqlo,lqoo,lqoo+1)=="#")then
return SubString(lqlo,0,lqoo)
endif
set lqoo=lqoo+1
endloop
return lqlo
endfunction
function lqOo takes nothing returns boolean
local real dx=GetDestructableX(GetFilterDestructable())-lpio
local real dy=GetDestructableY(GetFilterDestructable())-lp1o
return(dx*dx+dy*dy<=bj_enumDestructableRadius)
endfunction
function lq0o takes itemtype lq_o,integer lquo returns nothing
local group g
set bj_stockPickedItemType=lq_o
set bj_stockPickedItemLevel=lquo
set g=CreateGroup()
call GroupEnumUnitsOfType(g,"marketplace",lplo)
call ForGroup(g,function UpdateEachStockBuildingEnum)
call DestroyGroup(g)
set g=null
endfunction
function lqpo takes nothing returns nothing
local integer pickedItemId
local itemtype lq6o
local integer lqqo=0
local integer lq9o=0
local integer lquo
set lquo=1
loop
if(bj_stockAllowedPermanent[lquo])then
set lq9o=lq9o+1
if(GetRandomInt(1,lq9o)==1)then
set lq6o=ITEM_TYPE_PERMANENT
set lqqo=lquo
endif
endif
if(bj_stockAllowedCharged[lquo])then
set lq9o=lq9o+1
if(GetRandomInt(1,lq9o)==1)then
set lq6o=ITEM_TYPE_CHARGED
set lqqo=lquo
endif
endif
if(bj_stockAllowedArtifact[lquo])then
set lq9o=lq9o+1
if(GetRandomInt(1,lq9o)==1)then
set lq6o=ITEM_TYPE_ARTIFACT
set lqqo=lquo
endif
endif
set lquo=lquo+1
exitwhen lquo>$A
endloop
if(lq9o==0)then
set lq6o=null
return
endif
call lq0o(lq6o,lqqo)
set lq6o=null
endfunction
function l9io takes nothing returns nothing
call lqpo()
call TimerStart(bj_stockUpdateTimer,bj_STOCK_RESTOCK_INTERVAL,true,function lqpo)
endfunction
