exitwhen i<=0
set i=i-1
if(GetItemTypeId(UnitItemInSlot(u,i))==qlOo)then
return UnitItemInSlot(u,i)
endif
endloop
return null
endfunction
function ql0o takes item i,integer r returns boolean
local integer c
if i!=null then
set c=GetItemCharges(i)
return c==0 or c>=r
endif
return false
endfunction
function ql_o takes item i,integer r returns boolean
local integer c
if i!=null then
set c=GetItemCharges(i)
if c==0 or c>=r then
if c>r then
call SetItemCharges(i,c-r)
else
call RemoveItem(i)
endif
return true
endif
endif
return false
endfunction
function qluo takes unit u,string s,integer r,integer b,integer g returns nothing
local texttag t=CreateTextTag()
call SetTextTagPos(t,GetUnitX(u),GetUnitY(u),GetUnitFlyHeight(u)+30)
if O6uo(u)then
call SetTextTagText(t,s,.0276)
else
call SetTextTagText(t,s,.02)
endif
call SetTextTagColor(t,r,b,g,$BE)
call SetTextTagVelocity(t,.01775*Cos(bj_PI/ 2),.01775*Sin(bj_PI/ 2))
call SetTextTagPermanent(t,false)
call SetTextTagFadepoint(t,3)
call SetTextTagLifespan(t,3)
set t=null
endfunction
function qlpo takes unit u,string s,integer oq9o,integer r,integer b,integer g returns nothing
local texttag t=CreateTextTag()
call SetTextTagPos(t,GetUnitX(u),GetUnitY(u),GetUnitFlyHeight(u)+30)
call SetTextTagText(t,s,oq9o*.0023)
call SetTextTagColor(t,r,b,g,$BE)
call SetTextTagVelocity(t,.01775*Cos(bj_PI/ 2),.01775*Sin(bj_PI/ 2))
call SetTextTagPermanent(t,false)
call SetTextTagFadepoint(t,3)
call SetTextTagLifespan(t,3)
set t=null
endfunction
function ql6o takes string s,real x,real y,real z,real oq9o,integer r,integer g,integer b,real qlqo,real u6io returns texttag
set Vr=CreateTextTag()
call SetTextTagPos(Vr,x,y,z)
call SetTextTagText(Vr,s,oq9o*.0023)
call SetTextTagColor(Vr,r,g,b,$FF)
call SetTextTagVelocity(Vr,.0,.02)
call SetTextTagPermanent(Vr,false)
call SetTextTagFadepoint(Vr,qlqo)
call SetTextTagLifespan(Vr,u6io)
return Vr
endfunction
function ql9o takes string s,real x,real y,real z,real oq9o,integer r,integer g,integer b,real qlqo,real u6io,player p returns nothing
call SetTextTagVisibility(ql6o(s,x,y,z,oq9o,r,g,b,qlqo,u6io),GetLocalPlayer()==p)
