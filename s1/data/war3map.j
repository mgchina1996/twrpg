function l691i takes nothing returns nothing
set pI6l=Io1o()
call l6q6i('I05Y',"海洋秩序","某船长")
set pIql=pIql+("我一直认为拉芙海所存在的最大生物")+"
"
set pIql=pIql+("是龙龟。直到那个生物的出现才改变了我的想法 ..")+"
"
