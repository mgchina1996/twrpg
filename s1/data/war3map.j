endif
endfunction
function qIIo takes unit u,integer qIoo returns nothing
local integer lv=GetUnitAbilityLevel(u,qIoo)
if UnitRemoveAbility(u,qIoo)then
call UnitAddAbility(u,qIoo)
call UnitMakeAbilityPermanent(u,true,qIoo)
call SetUnitAbilityLevel(u,qIoo,lv)
endif
endfunction
